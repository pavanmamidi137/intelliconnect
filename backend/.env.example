# ---------------------------------------------------------------------------
# IntelliConnect backend — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supabase PostgreSQL. Use the IPv4 pooler for local machines
# (the direct db.<ref>.supabase.co host is IPv6-only):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave unset for local SQLite development.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# CORS — Next.js frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase Storage
# STORAGE_BACKEND=supabase uses Supabase Storage; "local" (default) uses
# MEDIA_ROOT on disk for development. Service-role key is server-side only.
# The bucket (default "meeting-files") is created automatically as private.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=meeting-files

# Upload limits
MAX_TRANSCRIPT_SIZE_MB=20
MAX_AUDIO_SIZE_MB=200

# ---------------------------------------------------------------------------
# AI providers — provider-independent architecture.
# AI_PRIMARY_PROVIDER / AI_SECONDARY_PROVIDER pick the order. All keys are
# optional; providers without keys are skipped.
# ---------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=groq
AI_SECONDARY_PROVIDER=cerebras

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Lower = faster analysis (capped thinking time; 0 is rejected by the API).
GEMINI_THINKING_BUDGET=256

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Development-only deterministic provider. Never enable in production.
AI_ENABLE_DEMO=false

# Minimum confidence (0..1) for automatic task/person assignment.
AI_CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Background jobs — Celery + Redis. Leave unset to run jobs in-process.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
