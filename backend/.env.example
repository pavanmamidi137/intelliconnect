# ---------------------------------------------------------------------------
# IntelliConnect backend — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — Supabase PostgreSQL. Use the IPv4 pooler for local machines
# (the direct db.<ref>.supabase.co host is IPv6-only):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Leave unset for local SQLite development.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# CORS — Next.js frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Supabase Storage
# STORAGE_BACKEND=supabase uses Supabase Storage; "local" (default) uses
# MEDIA_ROOT on disk for development. Service-role key is server-side only.
# The bucket (default "meeting-files") is created automatically as private.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=meeting-files

# Upload limits
MAX_TRANSCRIPT_SIZE_MB=20
MAX_AUDIO_SIZE_MB=200

# ---------------------------------------------------------------------------
# AI providers — provider-independent architecture.
# AI_PRIMARY_PROVIDER / AI_SECONDARY_PROVIDER pick the order. All keys are
# optional; providers without keys are skipped.
# ---------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=groq
AI_SECONDARY_PROVIDER=cerebras

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Lower = faster analysis (capped thinking time; 0 is rejected by the API).
GEMINI_THINKING_BUDGET=256

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

NVIDIA_API_KEY=
# GLM-5.3-flash NIM streams ~3x faster than the default nemotron on the
# same key (hosted NIM endpoints are stream-only; slower models queue
# 60-150s before the first token).
NVIDIA_MODEL=z-ai/glm-5.3-flash
NVIDIA_MAX_TOKENS=4096

# Development-only deterministic provider. Never enable in production.
AI_ENABLE_DEMO=false

# Minimum confidence (0..1) for automatic task/person assignment.
AI_CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# Task email notifications.
#
# Option A — SMTP (no domain needed, works today). Any SMTP relay works;
# Gmail + App Password is the simplest:
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=you@gmail.com          # your Gmail address
#   EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx  # 16-char App Password, NOT your login password
#   EMAIL_USE_TLS=true
#   DEFAULT_FROM_EMAIL="IntelliConnect <you@gmail.com>"
#
# Option B — Resend (requires a verified domain for delivery beyond your
# own inbox):
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM=IntelliConnect <tasks@yourdomain.com>
#
# Notifications are sent when analysis auto-assigns a task (>= confidence
# threshold) and again when you confirm pending tasks in Review.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=IntelliConnect <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Background jobs — Celery + Redis. Leave unset to run jobs in-process.
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Sessions persist until the user logs out.
JWT_REFRESH_DAYS=365
JWT_ACCESS_MINUTES=60
